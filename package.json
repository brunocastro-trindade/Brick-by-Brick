{
  "name": "brick-by-brick",
  "private": true,
  "version": "0.1.0",
  "description": "Jogo para aprender Python construindo uma cidade, tijolo por tijolo.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens:verificar && npm run typecheck && vite build",
    "preview": "vite preview",
    "tokens": "node scripts/gerar-tokens.mjs",
    "tokens:verificar": "node scripts/gerar-tokens.mjs --verificar",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . && node scripts/verificar-estilos.mjs",
    "test": "vitest",
    "conteudo:validar": "vitest run src/jogo/conteudo.python.test.ts",
    "fumaca": "node scripts/fumaca.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "lucide-react": "^1.56.0",
    "pyodide": "314.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
